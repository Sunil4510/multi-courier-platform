PORT=3000
DATABASE_URL="postgresql://username:password@localhost:5432/db_name?schema=public"

# UrbaneBolt Configuration
URBANEBOLT_USERNAME="your-username-here"
URBANEBOLT_PASSWORD="your-password-here"
URBANEBOLT_BASE_URL="https://uat.urbanebolt.in"

# Queue / Background Worker Configuration
QUEUE_POLL_INTERVAL_MS=2000
CONCURRENCY_LIMIT=5

# HTTP Client / Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=1000
HTTP_TIMEOUT_MS=10000
